<!-- TRENDING NOW -->
@using System.Linq 
<section class="trending-carousel bg-dark text-white py-5">
    <div class="container">
        <h2 class="text-center mb-4">🔥 Trending Now</h2>


        @if (Model?.TrendingProducts != null && Model.TrendingProducts.Any())  
        {
            <div id="trendingCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.TrendingProducts.Count; i++)
                    {
                        var product = Model.TrendingProducts[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="d-flex justify-content-center">
                                <a href="@Url.Action("Product", "Product", new { id = product.Id })" class="text-decoration-none">
                                    <div class="luxury-card text-center">
                                        <div class="luxury-card-img">
                                            <img src="@product.ImageUrl" class="d-block img-fluid rounded" alt="Trending @product.Name">
                                        </div>
                                        <div class="luxury-card-body d-flex flex-column align-items-center">
                                            <h5 class="product-name mb-1">@product.Name</h5>
                                            <p class="product-price mb-0">EGP @product.Price</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <ol class="carousel-indicators">
                    @for (int i = 0; i < Model.TrendingProducts.Count; i++)
                    {
                        <li data-bs-target="#trendingCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
                    }
                </ol>

                <a class="carousel-control-prev" href="#trendingCarousel" role="button" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </a>
                <a class="carousel-control-next" href="#trendingCarousel" role="button" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </a>
            </div>
        }
        else
        {
            <p class="text-center">No trending products available.</p>
        }
    </div>
</section>


<!-- BEST SELLERS -->
<section class="best-sellers py-6">
    <div class="container">
        <h2 class="text-center mb-5 display-4">Best Sellers</h2>

        @if (Model?.BestSellers != null && Model.BestSellers.Any())
        {
            <div class="row">
                @foreach (var product in Model.BestSellers)
                {
                    <div class="col-md-4 mb-4">
                        <a href="@Url.Action("Product", "Product", new { id = product.Id })" class="text-decoration-none">
                            <div class="card">
                                <img src="@product.ImageUrl" class="card-img-top rounded-3" style="height: 300px; object-fit: cover;" alt="@product.Name">
                                <div class="card-body text-center">
                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="card-text" style="color: #c08497; font-size: 1.25rem;">EGP @product.Price</p>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-center">No best-selling products at this time.</p>
        }
    </div>
</section>

<!-- NEWSLETTER – glass card on soft-light background -->
<section class="newsletter-section position-relative overflow-hidden py-6">
    <!-- sparkle canvas -->
    <canvas id="sparkleCanvas" class="position-absolute top-0 start-0 w-100 h-100"></canvas>

    <div class="container position-relative z-2">
        <div class="newsletter-card mx-auto px-4 px-sm-5 py-5 text-center glass shadow-lg">
            <h2 class="display-5 fw-semibold mb-3 reveal">Stay Updated</h2>
            <p class="fs-5 mb-5">Get exclusive deals &amp; early access to new drops ✨</p>

            <form id="newsletterForm" class="row g-0 justify-content-center reveal-up needs-validation" novalidate>
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="input-group newsletter-input-group">
                        <input type="email"
                               id="emailInput"
                               class="form-control form-control-lg"
                               placeholder="you@example.com"
                               required>
                        <button id="subscribeBtn"
                                type="submit"
                                class="btn btn-purple-gradient btn-lg px-4 d-flex align-items-center">
                            <span id="spinner" class="spinner-border spinner-border-sm me-2 d-none"></span>
                            <span id="btnText">Subscribe</span>
                        </button>
                    </div>
                    <div class="invalid-feedback text-start ps-2">
                        Please enter a valid email.
                    </div>
                </div>
            </form>

            <div id="alertMessage" class="mt-4"></div>
        </div>
    </div>
</section>


<style>
    /* === Hero CTA – luxe gradient & glow === */
    /* HERO — full-bleed photo + single translucent wash  */
    .hero-section {
        height: 100vh;
        background: url("/images/gg.jpg") center/cover no-repeat;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #fff;
    }
    .hero-section::before{
    background:linear-gradient(
        135deg,
        rgba(71,12,126,.70) 0%,
        rgba(130,32,221,.40) 100%
    );
    z-index:1;
}
        /* ONE overlay - 60 % purple at the top, 85 % near-black at the bottom */
        .hero-section::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( rgba(93,22,193,.60) 0%, rgba(32,24,60,.85) 100% );
            mix-blend-mode: multiply; /* lets the photo’s highlights show through */
            z-index: 0;
        }

    /* make sure the text & button sit above the overlay */
    .hero-content,
    .hero-text {
        position: relative;
        z-index: 1;
    }

    .btn-owl {
        background: #6b2dff; /* solid purple instead of gradient */
        border: none;
        color: #fff;
        box-shadow: 0 6px 18px rgba(91,48,255,.35);
        transition: transform .25s ease,box-shadow .25s ease;
    }

        .btn-owl:hover,
        .btn-owl:focus {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(91,48,255,.45);
        }

    /* Stretch video / image */
    .hero-bg-video,
    .hero-gradient-overlay {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* “overlay” now transparent (no gradient wash) */
    .hero-gradient-overlay {
        position: absolute;
        inset: 0;
        background: transparent; /* <-- gradient removed */
    }

    /* ===== NAVBAR TINT (flat) ===== */
    .bg-nav {
        background: #e9e9f0; /* flat light grey */
        transition: background .3s;
        box-shadow: 0 2px 6px rgba(0,0,0,.08);
    }

    body.dark-mode .bg-nav {
        background: #1e1e26;
    }

    /* ----- Newsletter Section ----- */
    /* Newsletter wrapper */
    .btn-purple-gradient {
        /* NEW: subtle indigo gradient */
        background: linear-gradient(135deg, #5b6dff 0%, #475aff 50%, #303ab8 100%);
    }

        .btn-purple-gradient:hover {
            background: #2930a8;
            box-shadow: 0 10px 26px rgba(71,86,255,.45);
        }
    /* === Newsletter wrapper – SOFT LIGHT === */
    .newsletter-section {
        /* gentle vignette from almost-white to light grey */
