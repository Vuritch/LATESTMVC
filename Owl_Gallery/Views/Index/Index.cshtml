@model Owl_Gallery.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

@* ----------  HERO SECTION  ---------- *@
<section class="hero-section">
    <div class="hero-content">
        <h1 class="display-1 fw-bold mb-4">Discover Unique Accessories</h1>
        <p class="lead fs-3 mb-5 animate-fade-in delay-200">
            Express your style with our handcrafted collection
        </p>

        <!-- 🔗 edit the Url.Action target if your route differs -->
        <a asp-controller="Products" asp-action="Products"
           class="btn btn-owl btn-lg px-5 animate-fade-in delay-400">
            Shop Now
        </a>
    </div>
</section>

<style>
    /* ------------- HERO (lightened) ------------- */
    /* HERO  – lighter, slightly blurred backdrop */
    .hero-section {
        height: 100vh;
        background: url("/images/gg.jpg") center/cover no-repeat fixed;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #fff;
    }

        /* ↓ LOWER opacity: 0.25 → 0.45 instead of 0.45 → 0.70 */
        .hero-section::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( rgba(93,22,193,.25) 0%, /* 25 % purple at top  */
            rgba(32,24,60,.45) 100% /* 45 % near-black bottom */
            );
            /*-- optional – small backdrop-blur to soften photo through overlay --*/
            backdrop-filter: blur(2px);
            mix-blend-mode: multiply;
            z-index: 0;
            pointer-events: none;
        }

        /* remove any accidental second overlay */
        .hero-section::after {
            content: none !important;
        }


        /* colour wash – lighter purple & more transparent */
        .hero-section::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( rgba(93,22,193,.35) 0%, /* 35 % at top  (was 55 %) */
            rgba(32,24,60,.60) 100%); /* 60 % bottom  (was 85 %) */
            mix-blend-mode: multiply;
            z-index: 1;
            pointer-events: none;
        }

    /* keep all text above overlay */
    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 900px;
        padding: 0 24px
    }

        /* optional – make sure headings are present & centred */
        .hero-content h1 {
            font-size: clamp(2.5rem,6vw,4.5rem);
            font-weight: 700;
            margin-bottom: 1.25rem;
        }


    /* ============================  CTA BUTTON  ====================== */
    .btn-owl {
        /* opaque gradient so the background never shows through */
        background: linear-gradient(135deg,#7648ff 0%,#5d2dff 50%,#4a1dfc 100%);
        color: #fff;
        border: none;
        border-radius: 3rem;
        padding: .9rem 3rem;
        font-weight: 600;
        letter-spacing: .5px;
        box-shadow: 0 6px 18px rgba(91,48,255,.35);
        transition: transform .25s ease,box-shadow .25s ease;
    }

        /* brighter & lifted on hover / focus */
        .btn-owl:hover,
        .btn-owl:focus {
            background: linear-gradient(135deg,#9b74ff 0%,#7648ff 50%,#5d2dff 100%);
            box-shadow: 0 10px 28px rgba(91,48,255,.45);
            transform: translateY(-3px);
            color: #fff; /* keep type white for contrast */
        }

        /* optional: active click feedback */
        .btn-owl:active {
            transform: translateY(0);
            box-shadow: 0 4px 14px rgba(91,48,255,.35);
        }

        /* optional soft pulse */
        .btn-owl::after {
            content: "";
            position: absolute;
            inset: -2px;
            border-radius: inherit;
            background: inherit;
            filter: blur(12px);
            opacity: .55;
            z-index: -1;
            animation: btnPulse 2.8s ease-in-out infinite;
        }
        @@keyframes btnPulse {
        0%,100%

    {
        opacity: .55;
        transform: scale(.96)
    }

    50% {
        opacity: .9;
        transform: scale(1.04)
    }

    }
</style>

