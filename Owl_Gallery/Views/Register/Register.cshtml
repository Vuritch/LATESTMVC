@model Owl_Gallery.Models.Register
@{
    Layout = "_Layout";
    ViewData["Title"] = "Register";
    ViewData["BodyClass"] = "auth-bg";
    bool isLogin = false;
}

<style>
    body.auth-bg {
        background: url('/images/dddd.jpg') center/cover no-repeat fixed;
        background-size: cover;
    }

        body.auth-bg::before {
            content: "";
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.3);
            pointer-events: none;
        }

    .auth-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
    }

    .auth-card {
        background: rgba(255,255,255,0.85);
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 400px;
    }
</style>

<div class="auth-page">
    <div class="auth-card">

        <!-- TAB BAR -->
        <div class="auth-tabs mb-4">
            <a class="auth-tab @(isLogin ? "active" : "")"
               href="@Url.Action("Login","Login")">Login</a>
            <a class="auth-tab @(!isLogin ? "active" : "")"
               href="@Url.Action("Register","Register")">Register</a>
            <div class="tab-slider"
                 style="transform:translateX(@(isLogin?0:100)%);"></div>
        </div>

        <!-- BODY -->
        <div class="auth-body">
            <h2 class="auth-title mb-3">Create Account</h2>
            <p class="subtitle mb-4">
                Join Owl Gallery to enjoy exclusive offers, easy order tracking, and a personalized shopping experience.
            </p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <form asp-controller="Register"
                  asp-action="Register"
                  method="post"
                  novalidate>
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">
                    <input asp-for="FirstName"
                           placeholder=" "
                           autocomplete="given-name"
                           class="form-control" />
                    <label>First Name</label>
                </div>

                <div class="form-group mb-3">
                    <input asp-for="LastName"
                           placeholder=" "
                           autocomplete="family-name"
                           class="form-control" />
                    <label>Last Name</label>
                </div>

                <div class="form-group mb-3">
                    <input asp-for="Email"
                           type="email"
                           placeholder=" "
                           autocomplete="email"
                           class="form-control" />
                    <label>Email address</label>
                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <input asp-for="Password"
                           id="registerPassword"
                           type="password"
                           placeholder=" "
                           autocomplete="new-password"
                           class="form-control" />
                    <label>Password</label>
                </div>

                <div id="strengthBox" class="mb-3">
                    <div id="strengthBar"><span></span></div>
                    <ul class="rule-list">
                        <li><i></i> At least 8 characters</li>
                        <li><i></i> At least 1 uppercase letter</li>
                        <li><i></i> At least 1 lowercase letter</li>
                        <li><i></i> At least 1 number</li>
                    </ul>
                </div>

                <div class="form-group mb-4">
                    <input asp-for="ConfirmPassword"
                           type="password"
                           placeholder=" "
                           autocomplete="new-password"
                           class="form-control" />
                    <label>Confirm Password</label>
                </div>

                <button type="submit"
                        class="btn-animate w-100">
                    Sign Up
                </button>
            </form>

            <p class="switch-link mt-3 text-center">
                Already have an account?
                <a href="@Url.Action("Login","Login")">Sign in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
