@model List<Owl_Gallery.Models.Product>
@using System
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Owl_Gallery.Helpers   <!-- enables GetCurrentPrice(...) -->
@{
    ViewData["Title"] = "Manage Products";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var sales = (IQueryable<Owl_Gallery.Models.Sale>)ViewBag.ActiveSales;  // controller must supply this
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Products</h2>
        <div>
            <a class="btn btn-success me-2" asp-action="CreateProduct">
                <i class="fas fa-plus"></i> Add New Product
            </a>
            <a class="btn btn-secondary" asp-action="Index">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <div class="card shadow p-4">
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th style="min-width:140px;">Price</th>
                        <th>Qty</th>
                        <th>Image</th>
                        <th style="width:160px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var live = p.GetCurrentPrice(sales);
                        bool onSale = live < p.Price;
                        string qtyClass =
                        p.Quantity == 0 ? "text-danger fw-bold"
                        : p.Quantity < 10 ? "text-warning fw-bold"
                        : "text-success";

                        <tr>
                            <td>@p.Id</td>

                            <td data-bs-toggle="tooltip" title="@p.Description">
                                @p.Name
                            </td>

                            <td>@p.Category</td>

                            <td>
                                @if (onSale)   /* onSale, live, p defined earlier */
                                {
                                    <span class="text-muted"><del>EGP @Math.Round(p.Price)</del></span>

                                    <br />
                                    <span class="text-success fw-semibold">
                                        Sale EGP @Math.Round(live)
                                    </span>
                                }
                                else
                                {
                                    <text>EGP @Math.Round(p.Price)</text>
                                }
                            </td>


                            <td class="@qtyClass">@p.Quantity</td>

                            <td>
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl"
                                         alt="@p.Name"
                                         class="rounded"
                                         style="max-height:50px;max-width:50px;object-fit:cover;"
                                         data-bs-toggle="tooltip"
                                         title="@p.Description" />
                                }
                                else
                                {
                                    <span>No Image</span>
                                }
                            </td>

                            <td>
                                <a class="btn btn-primary btn-sm" asp-action="EditProduct" asp-route-id="@p.Id">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <form asp-action="DeleteProduct" asp-route-id="@p.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm confirm-delete">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ManageProducts", new { page = ViewBag.CurrentPage - 1 })">Previous</a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("ManageProducts", new { page = i })">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("ManageProducts", new { page = ViewBag.CurrentPage + 1 })">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Confirm DELETE
            const deleteButtons = document.querySelectorAll('.confirm-delete');
            deleteButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();

                    Swal.fire({
                        title: 'Are you sure?',
                        text: "This will be deleted permanently!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            button.closest('form').submit();
                        }
                    });
                });
            });

            // Confirm SAVE (edit/save forms)
            const saveButtons = document.querySelectorAll('.confirm-save');
            saveButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();

                    Swal.fire({
                        title: 'Save Changes?',
                        text: "Do you want to save these changes?",
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#28a745',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, save it!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            button.closest('form').submit();
                        }
                    });
                });
            });

        });
    </script>
}
