@model List<Owl_Gallery.Models.Sale>
@using System.Globalization
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Manage Sales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <!-- header ‑‑‑ buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Sales</h2>

        <div>
            <a asp-action="CreateSale" class="btn btn-success me-2">
                <i class="fas fa-plus"></i> Add New Sale
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- table card -->
    <div class="card shadow p-4">
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Product</th>
                        <th style="min-width:140px;">Sale Price</th>
                        <th>Discount %</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th style="width:160px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.SaleIdId</td>
                            <td>@s.Product?.Name</td>

                            <td>
                                @if (s.SalePrice.HasValue)
                                {
                                    @($"EGP {Math.Round(s.SalePrice.Value)}")
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">calc %</span>
                                }
                            </td>

                            <td>@s.DiscountPercentage.ToString("F0") %</td>
                            <td>@s.StartDate.ToString("d", CultureInfo.InvariantCulture)</td>
                            <td>@s.EndDate.ToString("d", CultureInfo.InvariantCulture)</td>

                            <td>
                                <a asp-action="EditSale"
                                   asp-route-id="@s.SaleIdId"
                                   class="btn btn-primary btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </a>

                                <form asp-action="DeleteSale"
                                      asp-route-id="@s.SaleIdId"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit"
                                            class="btn btn-danger btn-sm confirm-delete">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- pagination -->
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="ManageSales"
                           asp-route-page="@(ViewBag.CurrentPage - 1)">
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link"
                               asp-action="ManageSales"
                               asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="ManageSales"
                           asp-route-page="@(ViewBag.CurrentPage + 1)">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Sweet‑alert confirmation for delete buttons
        document.querySelectorAll('.confirm-delete').forEach(btn => {
            btn.addEventListener('click', e => {
                e.preventDefault();
                Swal.fire({
                    title: 'Delete this sale?',
                    text: "This action cannot be undone.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it'
                }).then(r => {
                    if (r.isConfirmed) btn.closest('form').submit();
                });
            });
        });
    </script>
}
