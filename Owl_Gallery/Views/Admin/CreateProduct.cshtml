@model Owl_Gallery.Models.Product
@{
    ViewData["Title"] = "Add New Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">@ViewData["Title"]</h2>
    <div class="card shadow p-4">
        <form asp-action="CreateProduct"
              asp-controller="Admin"
              method="post"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Product Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">Category</label>
                <input asp-for="Category" class="form-control" />
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Price</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">Quantity</label>
                <input asp-for="Quantity" type="number" min="0" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label for="imageFile" class="form-label">Product Image</label>
                <input type="file"
                       name="imageFile"
                       id="imageFile"
                       class="form-control"
                       accept="image/*" />
                <span class="text-danger small">
                    @ViewData.ModelState["ImageUrl"]?.Errors.FirstOrDefault()?.ErrorMessage
                </span>
                <div class="form-text">
                    Upload an image from your computer.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Product Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="fas fa-save me-1"></i> Save Product
                </button>
                <a asp-action="ManageProducts"
                   asp-controller="Admin"
                   class="btn btn-secondary">
                    <i class="fas fa-times me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
