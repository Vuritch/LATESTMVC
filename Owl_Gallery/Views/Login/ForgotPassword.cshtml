@model Owl_Gallery.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}


<div class="auth-card">
    <h2 class="auth-title">Reset Your Password</h2>
    <p class="subtitle">Enter your email address and we'll send you a link to reset your password.</p>



    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn-animate w-100">Send Reset Link</button>
    </form>

    <p class="switch-link mt-3">
        Remembered your password?
        <a href="@Url.Action("Login", "Login")">Back to login</a>
    </p>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        @* Show success message *@
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    Toastify({
                        text: "@TempData["SuccessMessage"] @if (TempData["ResetLink"] != null)
                {
                    <text> - <a href='@TempData["ResetLink"]' style='color:white;text-decoration:underline;'>Reset Here</a></text>
                }",
                        duration: 6000,
                        gravity: "top",
                        position: "center",
                        backgroundColor: "#4CAF50",
                        stopOnFocus: true,
                        escapeMarkup: false,
                        style: {
                            borderRadius: "10px",
                            fontSize: "14px",
                            padding: "15px",
                        }
                    }).showToast();
            </text>
        }

        @* Show error message *@
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                    Toastify({
                        text: "@TempData["ErrorMessage"]",
                        duration: 4000,
                        gravity: "top",
                        position: "center",
                        backgroundColor: "#f44336",
                        stopOnFocus: true,
                        style: {
                            borderRadius: "10px",
                            fontSize: "14px",
                            padding: "15px"
                        }
                    }).showToast();
            </text>
        }
                });
    </script>
}
