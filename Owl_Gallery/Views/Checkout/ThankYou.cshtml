@{
    ViewData["Title"] = "Thank You";
    var orderId = ViewBag.OrderId;
}

<section class="thank-you-page d-flex align-items-center justify-content-center">
    <div class="thank-you-card animate__animated animate__zoomIn">
        <i class="fas fa-check-circle text-success fa-5x mb-4"></i>
        <h1 class="display-3 text-owl-purple fw-bold mb-3">Thank You!</h1>
        <p class="lead mb-3">
            Your order <span class="fw-bold">#@orderId</span> has been placed successfully.
        </p>
        <p class="mb-4 text-muted">
            We’ve received your order and will process it shortly.<br />
            📧 A confirmation email with your receipt has been sent.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-owl btn-xl">
            ← Back to Home
        </a>
    </div>
</section>

<style>
    .thank-you-page {
        min-height: 90vh;
        background: radial-gradient(circle at top left, #edf3ff, #deeaff);
        padding: 4rem 1rem;
    }

    .thank-you-card {
        max-width: 600px;
        width: 100%;
        background: #fff;
        padding: 3rem;
        border-radius: 1rem;
        box-shadow: 0 12px 32px rgba(0,0,0,0.08);
        text-align: center;
    }

    .text-owl-purple {
        color: #5d16c1;
    }

    .btn-owl {
        background-color: #5d16c1;
        color: #fff;
        padding: 0.9rem 2.5rem;
        border-radius: 2rem;
        font-size: 1.25rem;
        font-weight: 600;
        box-shadow: 0 6px 20px rgba(93,22,193,0.3);
        transition: transform .2s, box-shadow .2s;
    }

        .btn-owl.btn-xl {
            font-size: 1.3rem;
        }

        .btn-owl:hover {
            background-color: #4a109e;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(93,22,193,0.5);
        }

    /* Animation Fix */
    @@keyframes zoomIn {
        from

    {
        opacity: 0;
        transform: scale3d(0.3, 0.3, 0.3);
    }

    50% {
        opacity: 1;
    }

    to {
        transform: scale3d(1, 1, 1);
    }

    }

    .animate__zoomIn {
        animation-name: zoomIn;
        animation-duration: 0.6s;
        animation-fill-mode: both;
    }
</style>
